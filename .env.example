# ---------------------------------------------------------------------
# ADISYS FieldOps — environment configuration
# Copy to .env and replace every secret before deploying.
# ---------------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000

DATABASE_URL=postgres://adisys:adisys_dev_pw@127.0.0.1:5432/adisys_fieldops
PGSSLMODE=disable

# openssl rand -hex 48
JWT_ACCESS_SECRET=replace-me-access-secret
JWT_REFRESH_SECRET=replace-me-refresh-secret
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=30

# Private object storage. In production point STORAGE_DRIVER at s3.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_MB=10
ALLOWED_UPLOAD_MIME=image/jpeg,image/png,image/webp,image/heic,application/pdf

CORS_ORIGINS=http://localhost:5173,http://localhost:5174
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=600
LOGIN_RATE_LIMIT_MAX=10
BCRYPT_ROUNDS=12

SEED_DEFAULT_PASSWORD=Adisys@2026
