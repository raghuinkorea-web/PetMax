# ---------------------------------------------------------------------
# ADISYS FieldOps — static bundles for the admin portal and employee app
# Build with:  docker build -f Dockerfile.web --build-arg APP=admin .
# ---------------------------------------------------------------------
FROM node:22-alpine AS build
ARG APP=admin
WORKDIR /app

COPY package.json package-lock.json* ./
COPY packages/shared/package.json packages/shared/
COPY apps/admin/package.json apps/admin/
COPY apps/employee/package.json apps/employee/
RUN npm ci

COPY packages/shared packages/shared
COPY apps/${APP} apps/${APP}
RUN npm run build -w @adisys/shared && npm run build -w @adisys/${APP}
RUN cp -r apps/${APP}/dist /dist

# ---------------------------------------------------------------------
FROM nginx:1.27-alpine AS runtime
COPY --from=build /dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
